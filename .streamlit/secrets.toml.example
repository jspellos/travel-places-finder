# -------------------------------------------------------------------
# Rename this file to `secrets.toml` (remove `.example` from filename)
# Then paste in your real keys.
#
# DO NOT commit secrets.toml to git — it should stay local.
# The .gitignore in this repo already excludes it.
# On Streamlit Cloud, paste the same lines into the app's Settings → Secrets.
# -------------------------------------------------------------------

# Required.
GOOGLE_MAPS_API_KEY = "your-api-key-here"

# Optional: turns on the "Ask in plain English" box.
ANTHROPIC_API_KEY = "your-anthropic-key-here"

# Optional but recommended for a deployed app: a shared password that
# keeps strangers with the link from spending your API quota. Each browser
# asks for it once, then remembers it for a year. Leave it out to skip the
# lock screen (handy for local development).
APP_PASSWORD = "your-password-here"
